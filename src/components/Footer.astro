---
// Pinterest Footer Section per DESIGN.md
---

<footer class="bg-[#ffffff] border-t border-[#dadad3] py-12 px-4 md:px-6">
  <div class="max-w-[1280px] mx-auto">

    <!-- 4-Column Link Grid per DESIGN.md lines 387 & 523 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pb-12 border-b border-[#dadad3]">

      <!-- Column 1: PDF Tools -->
      <div>
        <p class="text-xs font-bold text-[#000000] uppercase tracking-wider mb-4">
          Convert Tools
        </p>
        <ul class="space-y-2.5 text-sm text-[#62625b]">
          <li><a href="#converter" class="hover:text-[#000000] transition-colors">PDF to JPG Pin</a></li>
          <li><a href="#converter" class="hover:text-[#000000] transition-colors">PDF to PNG Lossless</a></li>
          <li><a href="#converter" class="hover:text-[#000000] transition-colors">PDF to WebP Speed</a></li>
          <li><a href="#converter" class="hover:text-[#000000] transition-colors">PDF to TIFF Print</a></li>
          <li><a href="#converter" class="hover:text-[#000000] transition-colors">PDF to BMP Raw</a></li>
        </ul>
      </div>

      <!-- Column 2: Formats & Quality -->
      <div>
        <p class="text-xs font-bold text-[#000000] uppercase tracking-wider mb-4">
          Formats & Specs
        </p>
        <ul class="space-y-2.5 text-sm text-[#62625b]">
          <li><a href="#formats" class="hover:text-[#000000] transition-colors">150 DPI Screen</a></li>
          <li><a href="#formats" class="hover:text-[#000000] transition-colors">200 DPI Standard</a></li>
          <li><a href="#formats" class="hover:text-[#000000] transition-colors">300 DPI Archival</a></li>
          <li><a href="#formats" class="hover:text-[#000000] transition-colors">ZIP Batch Export</a></li>
          <li><a href="#formats" class="hover:text-[#000000] transition-colors">100 MB / 1 GB Limits</a></li>
        </ul>
      </div>

      <!-- Column 3: Platform -->
      <div>
        <p class="text-xs font-bold text-[#000000] uppercase tracking-wider mb-4">
          Platform
        </p>
        <ul class="space-y-2.5 text-sm text-[#62625b]">
          <li><a href="#howitworks" class="hover:text-[#000000] transition-colors">How It Works</a></li>
          <li><a href="#masonry" class="hover:text-[#000000] transition-colors">Pin Gallery</a></li>
          <li><a href="#features" class="hover:text-[#000000] transition-colors">Privacy Guarantee</a></li>
          <li><a href="/login" class="hover:text-[#000000] transition-colors">Creator Sign In</a></li>
          <li><a href="/signup" class="hover:text-[#000000] transition-colors">Create Free Account</a></li>
        </ul>
      </div>

      <!-- Column 4: About & Legal -->
      <div>
        <p class="text-xs font-bold text-[#000000] uppercase tracking-wider mb-4">
          Legal & Trust
        </p>
        <ul class="space-y-2.5 text-sm text-[#62625b]">
          <li><a href="#" class="hover:text-[#000000] transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-[#000000] transition-colors">Terms of Service</a></li>
          <li><a href="#" class="hover:text-[#000000] transition-colors">Cookie Notice</a></li>
          <li><a href="#" class="hover:text-[#000000] transition-colors">Security Overview</a></li>
          <li><a href="mailto:support@pdfspark.io" class="hover:text-[#000000] transition-colors">Contact Support</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Row per DESIGN.md lines 524 -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-full bg-[#e60023] flex items-center justify-center text-white text-xs font-bold">
          ⚡
        </div>
        <span class="text-sm font-bold text-[#000000]">PDFSpark</span>
        <span class="text-xs text-[#91918c] ml-2">© 2026 PDFSpark. All rights reserved.</span>
      </div>

      <div class="flex items-center gap-4 text-xs text-[#62625b]">
        <span>Designed with Pinterest-crafted elegance</span>
        <span class="text-[#dadad3]">·</span>
        <span class="text-[#103c25] bg-[#c7f0da] px-2.5 py-0.5 rounded-full font-bold">100% Client-Side</span>
      </div>
    </div>

  </div>
</footer>
