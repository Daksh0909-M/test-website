---
// Pinterest Hero & Dual Converter (PDF to Images & iLovePDF-Style Images to PDF) per DESIGN.md
---

<section id="converter" class="py-12 md:py-20 px-4 md:px-6 bg-[#fbfbf9] border-b border-[#dadad3]">
  <div class="max-w-[1280px] mx-auto flex flex-col items-center">

    <!-- Mode Switcher Tabs (Pinterest Filter Chips style) -->
    <div class="inline-flex items-center gap-1.5 p-1.5 bg-[#ffffff] border border-[#dadad3] rounded-full mb-6 shadow-sm">
      <button
        type="button"
        id="modeBtnPdfToImg"
        class="h-10 px-5 rounded-full text-xs font-bold transition-all cursor-pointer bg-[#000000] text-white shadow-xs flex items-center gap-2"
      >
        <span>📄</span>
        <span>PDF to Images</span>
      </button>
      <button
        type="button"
        id="modeBtnImgToPdf"
        class="h-10 px-5 rounded-full text-xs font-bold transition-all cursor-pointer bg-transparent text-[#62625b] hover:text-[#000000] hover:bg-[#f6f6f3] flex items-center gap-2"
      >
        <span>🖼️</span>
        <span>Images to PDF</span>
      </button>
    </div>

    <!-- Dynamic Display Headline (70px Display-XL per DESIGN.md) -->
    <h1 id="heroHeadline" class="text-center font-semibold text-[#000000] leading-[1.08] tracking-[-1.2px] mb-4 text-[36px] sm:text-[52px] md:text-[68px] max-w-[860px]">
      Convert PDF ideas to <span class="text-[#e60023]">every image format</span>
    </h1>

    <!-- Subtitle (Body-MD per DESIGN.md) -->
    <p id="heroSubtext" class="text-center text-[#62625b] text-base md:text-[18px] max-w-[580px] leading-relaxed mb-10">
      Transform PDF pages into high-resolution JPG, PNG, WebP, TIFF, and BMP images in seconds. Free, private, and browser-powered.
    </p>

    <!-- ════════ Main Converter Card ════════ -->
    <div id="mainConverterCard" class="w-full max-w-[640px] bg-[#ffffff] rounded-[16px] border border-[#e5e5e0] shadow-[0_4px_24px_rgba(0,0,0,0.06)] p-6 md:p-8 transition-all duration-300">

      <!-- ══════════════════════════════════════════
           PANEL 1: PDF to Images Tool
      ══════════════════════════════════════════ -->
      <div id="panelPdfToImg" class="block">
        <div class="flex items-center justify-between pb-5 border-b border-[#e5e5e0] mb-6">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#e60023] flex items-center justify-center text-white text-xs font-bold">⚡</span>
            <span class="text-sm font-bold text-[#000000]">PDF to Image Pin Converter</span>
          </div>
          <span class="text-xs font-semibold text-[#62625b] bg-[#f6f6f3] px-3 py-1 rounded-full border border-[#dadad3]">
            Instant Render
          </span>
        </div>

        <!-- Drop Zone -->
        <div
          id="dz"
          class="relative bg-[#f6f6f3] hover:bg-[#e5e5e0] border-2 border-dashed border-[#c8c8c1] hover:border-[#e60023] rounded-[16px] p-8 md:p-10 text-center cursor-pointer transition-all duration-200"
        >
          <input
            type="file"
            id="fi"
            accept=".pdf,application/pdf"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
          />
          <div class="w-12 h-12 rounded-full bg-[#ffffff] flex items-center justify-center text-[#e60023] mx-auto mb-3 shadow-sm border border-[#dadad3]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
            </svg>
          </div>
          <p id="dzLabel" class="text-sm font-bold text-[#000000] mb-1">
            Drop your PDF here, or <span class="text-[#e60023] underline underline-offset-2">browse files</span>
          </p>
          <p id="dzLimitText" class="text-xs text-[#62625b]">
            Up to 100 MB for guests · Sign up for up to 1 GB
          </p>
        </div>

        <!-- Format Selection -->
        <div class="mt-6 pt-6 border-t border-[#e5e5e0]">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-[#62625b] uppercase tracking-wider">Select Output Format</span>
            <span class="text-[11px] text-[#91918c]">Lossless extraction</span>
          </div>

          <div id="fmtTabs" class="flex flex-wrap gap-2 mb-6">
            {[
              { f: "jpg", label: "JPG", desc: "Most Popular" },
              { f: "png", label: "PNG", desc: "Lossless" },
              { f: "webp", label: "WebP", desc: "Modern Web" },
              { f: "tiff", label: "TIFF", desc: "Print Pro" },
              { f: "bmp", label: "BMP", desc: "Raw Bit" },
            ].map(({ f, label, desc }, i) => (
              <button
                type="button"
                data-fmt={f}
                class={`filter-chip-btn relative px-4 py-2 rounded-full text-xs font-bold border transition-all cursor-pointer flex items-center gap-1.5 ${
                  i === 0
                    ? "bg-[#000000] text-white border-[#000000]"
                    : "bg-[#f6f6f3] text-[#000000] border-transparent hover:bg-[#e5e5e0]"
                }`}
              >
                <span>{label}</span>
                <span class="text-[10px] opacity-75">· {desc}</span>
              </button>
            ))}
          </div>

          <!-- Settings -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 bg-[#f6f6f3] rounded-[16px] border border-[#e5e5e0] mb-6">
            <div>
              <div class="flex justify-between items-center mb-1.5">
                <label class="text-xs font-bold text-[#000000]" for="qSlider">Image Quality</label>
                <span id="qVal" class="text-xs font-bold text-[#e60023]">90%</span>
              </div>
              <input
                type="range"
                id="qSlider"
                min="10"
                max="100"
                value="90"
                class="w-full h-1.5 bg-[#e5e5e0] rounded-lg appearance-none cursor-pointer accent-[#e60023]"
              />
            </div>
            <div>
              <span class="text-xs font-bold text-[#000000] block mb-1.5">Resolution</span>
              <div id="dpiTabs" class="flex gap-1.5">
                {["150", "200", "300"].map((dpi, i) => (
                  <button
                    type="button"
                    data-dpi={dpi}
                    class={`flex-1 py-1.5 text-xs font-bold rounded-full border transition-all cursor-pointer ${
                      i === 0
                        ? "bg-[#000000] text-white border-[#000000]"
                        : "bg-[#ffffff] text-[#000000] border-[#dadad3] hover:bg-[#f6f6f3]"
                    }`}
                  >
                    {dpi} DPI
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Convert Button -->
          <button
            type="button"
            id="cvtBtn"
            disabled
            class="w-full h-12 rounded-[16px] bg-[#e60023] hover:bg-[#cc001f] disabled:bg-[#f6f6f3] disabled:text-[#91918c] disabled:cursor-not-allowed text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
            <span id="cvtBtnText">Convert PDF to JPG</span>
          </button>
        </div>
      </div>

      <!-- ══════════════════════════════════════════
           PANEL 2: Images to PDF (iLovePDF Style)
      ══════════════════════════════════════════ -->
      <div id="panelImgToPdf" class="hidden">
        <div class="flex items-center justify-between pb-5 border-b border-[#e5e5e0] mb-6">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-[#e60023] flex items-center justify-center text-white text-xs font-bold">🖼️</span>
            <span class="text-sm font-bold text-[#000000]">Images to PDF Converter</span>
          </div>
          <span class="text-xs font-semibold text-[#103c25] bg-[#c7f0da] px-3 py-1 rounded-full border border-[#103c25]/20">
            Interactive Stage
          </span>
        </div>

        <!-- Initial Upload Drop Zone (Shown when 0 images selected) -->
        <div
          id="imgDz"
          class="relative bg-[#f6f6f3] hover:bg-[#e5e5e0] border-2 border-dashed border-[#c8c8c1] hover:border-[#e60023] rounded-[16px] p-8 md:p-10 text-center cursor-pointer transition-all duration-200"
        >
          <input
            type="file"
            id="imgInput"
            multiple
            accept="image/png, image/jpeg, image/webp, image/bmp, image/tiff, image/gif"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
          />
          <div class="w-12 h-12 rounded-full bg-[#ffffff] flex items-center justify-center text-[#e60023] mx-auto mb-3 shadow-sm border border-[#dadad3]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          </div>
          <p id="imgDzLabel" class="text-sm font-bold text-[#000000] mb-1">
            Drop multiple images here, or <span class="text-[#e60023] underline underline-offset-2">browse files</span>
          </p>
          <p id="imgDzLimitText" class="text-xs text-[#62625b]">
            Supports JPG, PNG, WebP, TIFF, BMP · Up to 100 MB for guests
          </p>
        </div>

        <!-- ── Interactive Image Stage (iLovePDF signature canvas) ── -->
        <div id="imgStage" class="hidden">
          <!-- Stage Top Bar: Count + Sorting + Add More + Clear All -->
          <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#e5e5e0] flex-wrap gap-2">
            <div class="flex items-center gap-2">
              <span id="imgCountBadge" class="text-xs font-bold text-[#000000]">0 images</span>
              <span id="imgTotalSizeBadge" class="text-[11px] text-[#62625b] bg-[#f6f6f3] px-2.5 py-0.5 rounded-full border border-[#dadad3]">0 MB</span>
            </div>
            <div class="flex items-center gap-2">
              <!-- Sort A-Z button -->
              <button
                type="button"
                id="sortImagesBtn"
                class="px-2.5 py-1 text-xs font-semibold rounded-full bg-[#f6f6f3] hover:bg-[#e5e5e0] text-[#000000] border border-[#dadad3] transition-colors cursor-pointer flex items-center gap-1"
                title="Sort by file name"
              >
                <span>🔤</span>
                <span>Sort A-Z</span>
              </button>
              <!-- Clear all -->
              <button
                type="button"
                id="clearImagesBtn"
                class="px-2.5 py-1 text-xs font-semibold text-[#e60023] hover:bg-red-50 rounded-full transition-colors cursor-pointer"
              >
                Clear all
              </button>
            </div>
          </div>

          <!-- Interactive Grid of Image Tiles (Rotate, Reorder, Remove) -->
          <div id="imgTilesGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 max-h-[320px] overflow-y-auto p-1 scrollbar-thin">
            <!-- Dynamically populated -->
          </div>

          <!-- Add More Images Drop Banner -->
          <div class="mt-3 relative bg-[#f6f6f3] hover:bg-[#e5e5e0] border-2 border-dashed border-[#dadad3] hover:border-[#e60023] rounded-[14px] p-3 text-center cursor-pointer transition-colors">
            <input
              type="file"
              id="imgAddMoreInput"
              multiple
              accept="image/png, image/jpeg, image/webp, image/bmp, image/tiff, image/gif"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
            />
            <span class="text-xs font-bold text-[#e60023] flex items-center justify-center gap-1.5">
              <span>➕</span>
              <span>Add more images</span>
            </span>
          </div>
        </div>

        <!-- ── iLovePDF Signature Settings Panel ── -->
        <div id="imgSettingsPanel" class="mt-6 pt-6 border-t border-[#e5e5e0]">
          
          <!-- 1. Page Orientation (iLovePDF visual cards) -->
          <div class="mb-5">
            <span class="text-xs font-bold text-[#000000] block mb-2">Page Orientation</span>
            <div class="grid grid-cols-2 gap-3" id="orientationCards">
              <button
                type="button"
                data-orient="portrait"
                class="orient-card h-14 rounded-[14px] border-2 border-[#000000] bg-[#ffffff] p-2 flex items-center justify-center gap-3 font-bold text-xs text-[#000000] cursor-pointer transition-all shadow-xs"
              >
                <!-- Portrait page icon -->
                <div class="w-5 h-7 border-2 border-[#000000] rounded-xs bg-[#f6f6f3]"></div>
                <span>Portrait</span>
              </button>
              <button
                type="button"
                data-orient="landscape"
                class="orient-card h-14 rounded-[14px] border border-[#dadad3] bg-[#f6f6f3] hover:bg-[#e5e5e0] p-2 flex items-center justify-center gap-3 font-bold text-xs text-[#62625b] hover:text-[#000000] cursor-pointer transition-all"
              >
                <!-- Landscape page icon -->
                <div class="w-7 h-5 border-2 border-[#62625b] rounded-xs bg-[#ffffff]"></div>
                <span>Landscape</span>
              </button>
            </div>
          </div>

          <!-- 2. Page Size & Margin Row (iLovePDF style) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
            
            <!-- Page Size -->
            <div>
              <span class="text-xs font-bold text-[#000000] block mb-2">Page Size</span>
              <div class="flex flex-col gap-1.5" id="pageSizeOptions">
                {[
                  { val: "fit", label: "Fit (Same size as image)", desc: "No white borders" },
                  { val: "a4", label: "A4 (297 × 210 mm)", desc: "Standard document" },
                  { val: "letter", label: "US Letter (215 × 279 mm)", desc: "North America" },
                ].map(({ val, label, desc }, i) => (
                  <button
                    type="button"
                    data-size={val}
                    class={`page-size-btn text-left p-2.5 rounded-[12px] border transition-all cursor-pointer flex items-center justify-between ${
                      i === 0
                        ? "bg-[#ffffff] border-[#000000] shadow-xs"
                        : "bg-[#f6f6f3] border-transparent hover:bg-[#e5e5e0]"
                    }`}
                  >
                    <div>
                      <p class="text-xs font-bold text-[#000000] leading-none">{label}</p>
                      <p class="text-[10px] text-[#62625b] mt-0.5">{desc}</p>
                    </div>
                    <span class="radio-indicator w-3.5 h-3.5 rounded-full border-2 border-[#000000] flex items-center justify-center">
                      {i === 0 && <span class="w-1.5 h-1.5 rounded-full bg-[#000000]"></span>}
                    </span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Page Margin (iLovePDF 3 cards: None, Small, Big) -->
            <div>
              <span class="text-xs font-bold text-[#000000] block mb-2">Margin</span>
              <div class="grid grid-cols-3 gap-2" id="marginCards">
                {[
                  { val: "none", label: "No Margin", iconBorder: "p-0.5" },
                  { val: "small", label: "Small", iconBorder: "p-1.5" },
                  { val: "big", label: "Big", iconBorder: "p-2.5" },
                ].map(({ val, label, iconBorder }, i) => (
                  <button
                    type="button"
                    data-margin={val}
                    class={`margin-card h-24 rounded-[12px] border transition-all cursor-pointer flex flex-col items-center justify-center p-2 text-center ${
                      i === 0
                        ? "bg-[#ffffff] border-[#000000] shadow-xs"
                        : "bg-[#f6f6f3] border-[#dadad3] hover:bg-[#e5e5e0]"
                    }`}
                  >
                    <!-- Mini visual preview of margin box -->
                    <div class={`w-9 h-11 border border-[#000000] rounded-xs bg-[#ffffff] mb-1.5 flex items-center justify-center ${iconBorder}`}>
                      <div class="w-full h-full bg-[#e5e5e0] rounded-2xs"></div>
                    </div>
                    <span class="text-[11px] font-bold text-[#000000]">{label}</span>
                  </button>
                ))}
              </div>
            </div>

          </div>

          <!-- 3. iLovePDF Merge Checkbox -->
          <div class="flex items-center gap-3 p-3 bg-[#f6f6f3] rounded-[14px] border border-[#e5e5e0] mb-6">
            <input
              type="checkbox"
              id="mergeAllCheck"
              checked
              class="w-4 h-4 rounded-md accent-[#e60023] cursor-pointer"
            />
            <label for="mergeAllCheck" class="text-xs font-bold text-[#000000] cursor-pointer select-none">
              Merge all images into one single PDF file
              <span class="block text-[11px] font-normal text-[#62625b]">Uncheck if you prefer individual PDF files in a ZIP</span>
            </label>
          </div>

          <!-- Convert Button (Pinterest Red Primary CTA) -->
          <button
            type="button"
            id="createPdfBtn"
            disabled
            class="w-full h-12 rounded-[16px] bg-[#e60023] hover:bg-[#cc001f] disabled:bg-[#f6f6f3] disabled:text-[#91918c] disabled:cursor-not-allowed text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors cursor-pointer shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
            <span id="createPdfBtnText">Convert to PDF</span>
          </button>
        </div>
      </div>

      <!-- ── Large File Alert Card (>100MB) ── -->
      <div id="largeFileAlert" class="hidden mt-4 p-4 bg-[#fffbeb] border border-[#fde68a] rounded-[16px]">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-[#fef3c7] flex items-center justify-center text-lg shrink-0">
            📦
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2 flex-wrap mb-1">
              <span class="text-xs font-bold text-[#92400e]">Account Required for Files Over 100 MB</span>
              <span id="largeFileSizeBadge" class="text-[10px] font-bold bg-[#fef3c7] text-[#b45309] px-2 py-0.5 rounded-full border border-[#fcd34d]">120 MB</span>
            </div>
            <p class="text-xs text-[#78350f] leading-relaxed">
              Anonymous guest uploads are capped at 100 MB. Create a free account to unlock conversions up to <strong>1 GB</strong> instantly!
            </p>
            <div class="flex gap-2 mt-3 flex-wrap">
              <button
                type="button"
                id="largeFileSignupBtn"
                class="h-9 px-4 rounded-xl bg-[#e60023] hover:bg-[#cc001f] text-white text-xs font-bold transition-colors cursor-pointer shadow-sm"
              >
                Sign up for free (Unlock 1 GB)
              </button>
              <button
                type="button"
                id="largeFileLoginBtn"
                class="h-9 px-3.5 rounded-xl bg-[#ffffff] border border-[#dadad3] hover:bg-[#f6f6f3] text-[#000000] text-xs font-bold transition-colors cursor-pointer"
              >
                Sign in
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Shared Progress Box ── -->
      <div id="progBox" class="hidden mt-4 p-4 bg-[#f6f6f3] rounded-[16px] border border-[#e5e5e0]">
        <div class="flex items-center gap-3 mb-2.5">
          <div class="w-4 h-4 border-2 border-[#e60023] border-t-transparent rounded-full animate-spin shrink-0"></div>
          <span id="progTitle" class="text-xs font-bold text-[#000000]">Processing files…</span>
        </div>
        <div class="h-2 bg-[#e5e5e0] rounded-full overflow-hidden">
          <div id="progBar" class="h-full bg-[#e60023] rounded-full transition-all duration-200" style="width: 0%"></div>
        </div>
        <p id="progLbl" class="text-[11px] text-[#62625b] mt-2 font-medium">Preparing…</p>
      </div>

      <!-- ── Shared Done State ── -->
      <div id="doneBox" class="hidden mt-4 p-4 bg-[#c7f0da]/50 border border-[#103c25]/20 rounded-[16px] items-center gap-3 flex-wrap">
        <div class="w-8 h-8 rounded-full bg-[#103c25] text-white flex items-center justify-center font-bold text-sm shrink-0">
          ✓
        </div>
        <div class="flex-1">
          <p id="doneTitle" class="text-xs font-bold text-[#103c25]">Conversion complete!</p>
          <p id="doneLbl" class="text-[11px] text-[#103c25]/80 font-medium">Ready for download</p>
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            id="dlBtn"
            class="h-9 px-4 rounded-full bg-[#e60023] hover:bg-[#cc001f] text-white text-xs font-bold flex items-center gap-1.5 transition-colors cursor-pointer shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            <span id="dlBtnText">Download PDF</span>
          </button>
          <button
            type="button"
            id="rstBtn"
            class="h-9 px-3.5 rounded-full bg-[#ffffff] border border-[#dadad3] hover:bg-[#f6f6f3] text-[#000000] text-xs font-bold transition-colors cursor-pointer"
          >
            Reset
          </button>
        </div>
      </div>

    </div>

    <!-- Trust Strip -->
    <div class="mt-8 flex flex-wrap justify-center gap-6 text-[#62625b] text-xs font-medium">
      <span class="flex items-center gap-1.5">🔒 <span>SSL Encrypted</span></span>
      <span class="flex items-center gap-1.5">🗑️ <span>Zero Server Retention</span></span>
      <span class="flex items-center gap-1.5">⚡ <span>Fast Client-Side Processing</span></span>
      <span class="flex items-center gap-1.5">✨ <span>Pinterest-Crafted Quality</span></span>
    </div>

  </div>
</section>

<!-- Load pdf.js, JSZip, and jsPDF from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
  declare const pdfjsLib: any;
  declare const JSZip: any;
  declare const jspdf: any;

  window.addEventListener('load', () => {
    if (typeof pdfjsLib !== 'undefined') {
      pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
  });

  /* ── Mode State: 'pdf-to-img' vs 'img-to-pdf' ── */
  let currentMode: 'pdf-to-img' | 'img-to-pdf' = 'pdf-to-img';
  const modeBtnPdfToImg = document.getElementById('modeBtnPdfToImg')!;
  const modeBtnImgToPdf = document.getElementById('modeBtnImgToPdf')!;
  const panelPdfToImg = document.getElementById('panelPdfToImg')!;
  const panelImgToPdf = document.getElementById('panelImgToPdf')!;
  const heroHeadline = document.getElementById('heroHeadline')!;
