  // Render Image Canvas / Stage (iLovePDF Style)
  function renderImageStage() {
    imgTilesGrid.innerHTML = '';

    if (selectedImagesList.length === 0) {
      imgStage.classList.add('hidden');
      imgDz.classList.remove('hidden');
      createPdfBtn.disabled = true;
