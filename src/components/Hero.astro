      const tile = document.createElement('div');
      tile.className = 'relative bg-[#f6f6f3] border border-[#dadad3] rounded-[16px] p-2 flex flex-col items-center group hover:border-[#000000] transition-all';

      // Thumbnail Image Frame with rotation
      const frame = document.createElement('div');
