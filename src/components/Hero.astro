  // Custom Encoders
  function canvasToBmpBlob(canvas: HTMLCanvasElement): Blob {
    const ctx = canvas.getContext('2d')!;
    const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const width = canvas.width;
    const height = canvas.height;
    const rowSize = Math.floor((24 * width + 31) / 32) * 4;
    const pixelArraySize = rowSize * height;
    const fileSize = 54 + pixelArraySize;
    const buffer = new ArrayBuffer(fileSize);
    const view = new DataView(buffer);

    view.setUint16(0, 0x4D42, false);
    view.setUint32(2, fileSize, true);
    view.setUint32(6, 0, true);
    view.setUint32(10, 54, true);

    view.setUint32(14, 40, true);
    view.setInt32(18, width, true);
    view.setInt32(22, height, true);
    view.setUint16(26, 1, true);
    view.setUint16(28, 24, true);
    view.setUint32(30, 0, true);
    view.setUint32(34, pixelArraySize, true);
    view.setInt32(38, 2835, true);
    view.setInt32(42, 2835, true);
    view.setUint32(46, 0, true);
    view.setUint32(50, 0, true);

    const data = imgData.data;
    let offset = 54;
    for (let y = height - 1; y >= 0; y--) {
      let rowOffset = offset;
      for (let x = 0; x < width; x++) {
        const i = (y * width + x) * 4;
        view.setUint8(rowOffset++, data[i + 2]);
        view.setUint8(rowOffset++, data[i + 1]);
        view.setUint8(rowOffset++, data[i]);
      }
      while (rowOffset < offset + rowSize) {
        view.setUint8(rowOffset++, 0);
      }
      offset += rowSize;
    }
    return new Blob([buffer], { type: 'image/bmp' });
  }

  function canvasToTiffBlob(canvas: HTMLCanvasElement, dpi: number): Blob {
    const ctx = canvas.getContext('2d')!;
    const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
    const width = canvas.width;
    const height = canvas.height;
    const rgbLength = width * height * 3;
    const totalSize = 168 + rgbLength;
    const buffer = new ArrayBuffer(totalSize);
    const view = new DataView(buffer);

    view.setUint16(0, 0x4949, false);
    view.setUint16(2, 42, true);
    view.setUint32(4, 8, true);
    view.setUint16(8, 11, true);

    function writeTag(offset: number, tagId: number, type: number, count: number, valOrOffset: number) {
      view.setUint16(offset, tagId, true);
      view.setUint16(offset + 2, type, true);
      view.setUint32(offset + 4, count, true);
      view.setUint32(offset + 8, valOrOffset, true);
    }

    let tagOffset = 10;
    writeTag(tagOffset, 0x0100, 4, 1, width); tagOffset += 12;
    writeTag(tagOffset, 0x0101, 4, 1, height); tagOffset += 12;
    writeTag(tagOffset, 0x0102, 3, 3, 146); tagOffset += 12;
    writeTag(tagOffset, 0x0103, 3, 1, 1); tagOffset += 12;
    writeTag(tagOffset, 0x0106, 3, 1, 2); tagOffset += 12;
    writeTag(tagOffset, 0x0111, 4, 1, 168); tagOffset += 12;
    writeTag(tagOffset, 0x0115, 3, 1, 3); tagOffset += 12;
    writeTag(tagOffset, 0x0116, 4, 1, height); tagOffset += 12;
    writeTag(tagOffset, 0x0117, 4, 1, rgbLength); tagOffset += 12;
    writeTag(tagOffset, 0x011A, 5, 1, 152); tagOffset += 12;
    writeTag(tagOffset, 0x011B, 5, 1, 160); tagOffset += 12;

    view.setUint32(tagOffset, 0, true);
    view.setUint16(146, 8, true);
    view.setUint16(148, 8, true);
    view.setUint16(150, 8, true);
    view.setUint32(152, dpi, true);
    view.setUint32(156, 1, true);
    view.setUint32(160, dpi, true);
    view.setUint32(164, 1, true);

    const src = imgData.data;
    const dest = new Uint8Array(buffer, 168, rgbLength);
    let srcIdx = 0;
    let destIdx = 0;
    const totalPixels = width * height;
    for (let p = 0; p < totalPixels; p++) {
      dest[destIdx++] = src[srcIdx++];
      dest[destIdx++] = src[srcIdx++];
      dest[destIdx++] = src[srcIdx++];
      srcIdx++;
    }
    return new Blob([buffer], { type: 'image/tiff' });
  }

  async function convertCanvasToBlob(canvas: HTMLCanvasElement, fmt: string, quality: number, dpi: number): Promise<Blob> {
    if (fmt === 'bmp') return canvasToBmpBlob(canvas);
    if (fmt === 'tiff') return canvasToTiffBlob(canvas, dpi);
    if (fmt === 'png') {
      return new Promise((res, rej) => canvas.toBlob(b => b ? res(b) : rej(new Error('PNG fail')), 'image/png'));
    }
    if (fmt === 'webp') {
      return new Promise((res, rej) => canvas.toBlob(b => b ? res(b) : rej(new Error('WebP fail')), 'image/webp', quality));
    }
    return new Promise((res, rej) => canvas.toBlob(b => b ? res(b) : rej(new Error('JPG fail')), 'image/jpeg', quality));
  }

  cvtBtn?.addEventListener('click', async () => {
    if (!selectedPdfFile) return;

    const fmt = currentFormat;
    const dpi = currentDpi;
    const quality = parseInt(qs.value) / 100;
    const scale = dpi / 72;

    cvtBtn.style.display = 'none';
    progBox.classList.remove('hidden');
    doneBox.classList.add('hidden');

    try {
      setProgress(5, 'Loading PDF…', 'Initializing document reader');
      const arrayBuffer = await selectedPdfFile.arrayBuffer();
      const pdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      const totalPages = pdfDoc.numPages;

      setProgress(10, `Loaded ${totalPages} page${totalPages > 1 ? 's' : ''}`, 'Rendering pages to canvas');
      const zip = new JSZip();
      const baseName = selectedPdfFile.name.replace(/\.pdf$/i, '');

      for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
        const pct = 10 + Math.round(((pageNum - 1) / totalPages) * 78);
        setProgress(pct, `Converting pages…`, `Rendering page ${pageNum} of ${totalPages} to ${fmt.toUpperCase()}`);

        const page = await pdfDoc.getPage(pageNum);
        const viewport = page.getViewport({ scale });

        const canvas = document.createElement('canvas');
        canvas.width = Math.round(viewport.width);
        canvas.height = Math.round(viewport.height);
        const ctx = canvas.getContext('2d')!;

        if (fmt !== 'png') {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        }

        await page.render({ canvasContext: ctx, viewport }).promise;

        const blob = await convertCanvasToBlob(canvas, fmt, quality, dpi);
        const fileName = `${baseName}_page_${String(pageNum).padStart(3, '0')}.${fmt}`;
        zip.file(fileName, blob);
      }

      setProgress(92, 'Packaging ZIP archive…', 'Compressing output files');
      const content = await zip.generateAsync({
        type: 'blob',
        compression: 'DEFLATE',
        compressionOptions: { level: 6 }
      });

      downloadedResultBlob = content;
      downloadedFileName = `${selectedPdfFile.name.replace(/\.pdf$/i, '')}_${fmt.toUpperCase()}_images.zip`;

      setProgress(100, 'Complete!', 'All pages converted successfully');
      await new Promise(r => setTimeout(r, 200));

      progBox.classList.add('hidden');
      doneBox.classList.remove('hidden');
      doneBox.classList.add('flex');
      doneTitle.textContent = 'PDF to Images complete!';
      doneLbl.textContent = `${totalPages} page${totalPages > 1 ? 's' : ''} converted to ${fmt.toUpperCase()} · ${(content.size / 1024).toFixed(0)} KB`;
      dlBtnText.textContent = 'Download ZIP';

    } catch (err) {
      console.error(err);
      progBox.classList.add('hidden');
      cvtBtn.style.display = 'flex';
      alert('Conversion failed: ' + (err as Error).message);
    }
