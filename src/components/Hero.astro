      img.style.transform = `rotate(${item.rotation}deg)`;
      frame.appendChild(img);
      tile.appendChild(frame);

      // Page Badge
      const pageBadge = document.createElement('span');
      pageBadge.className = 'absolute top-3 left-3 bg-[#000000]/75 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full';
      pageBadge.textContent = `#${index + 1}`;
      tile.appendChild(pageBadge);

      // File name (truncated)
      const nameP = document.createElement('p');
      nameP.className = 'text-[11px] font-semibold text-[#000000] truncate w-full mt-1.5 text-center px-1';
      nameP.textContent = item.file.name;
      tile.appendChild(nameP);

      // Hover Action Bar (iLovePDF signature: Rotate, Move, Delete)
      const actions = document.createElement('div');
      actions.className = 'flex items-center justify-center gap-1.5 mt-2 w-full pt-1.5 border-t border-[#e5e5e0]';

      // Rotate Button 🔄
      const rotateBtn = document.createElement('button');
      rotateBtn.type = 'button';
      rotateBtn.className = 'w-7 h-7 rounded-full bg-[#ffffff] border border-[#dadad3] hover:bg-[#e5e5e0] text-[#000000] flex items-center justify-center text-xs transition-colors cursor-pointer shadow-2xs';
      rotateBtn.title = 'Rotate 90° clockwise';
      rotateBtn.innerHTML = '🔄';
      rotateBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        item.rotation = (item.rotation + 90) % 360;
        img.style.transform = `rotate(${item.rotation}deg)`;
      });
      actions.appendChild(rotateBtn);

      // Move Left Button ◀
      if (index > 0) {
        const moveLeftBtn = document.createElement('button');
        moveLeftBtn.type = 'button';
        moveLeftBtn.className = 'w-7 h-7 rounded-full bg-[#ffffff] border border-[#dadad3] hover:bg-[#e5e5e0] text-[#000000] flex items-center justify-center text-[10px] font-bold transition-colors cursor-pointer shadow-2xs';
        moveLeftBtn.title = 'Move left';
        moveLeftBtn.innerHTML = '◀';
        moveLeftBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const temp = selectedImagesList[index - 1];
          selectedImagesList[index - 1] = item;
          selectedImagesList[index] = temp;
          renderImageStage();
        });
        actions.appendChild(moveLeftBtn);
      }

      // Move Right Button ▶
      if (index < selectedImagesList.length - 1) {
        const moveRightBtn = document.createElement('button');
        moveRightBtn.type = 'button';
        moveRightBtn.className = 'w-7 h-7 rounded-full bg-[#ffffff] border border-[#dadad3] hover:bg-[#e5e5e0] text-[#000000] flex items-center justify-center text-[10px] font-bold transition-colors cursor-pointer shadow-2xs';
        moveRightBtn.title = 'Move right';
        moveRightBtn.innerHTML = '▶';
        moveRightBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const temp = selectedImagesList[index + 1];
          selectedImagesList[index + 1] = item;
          selectedImagesList[index] = temp;
          renderImageStage();
        });
        actions.appendChild(moveRightBtn);
      }

      // Delete Button 🗑️
      const delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'w-7 h-7 rounded-full bg-[#ffffff] border border-[#dadad3] hover:bg-red-50 text-[#e60023] flex items-center justify-center text-xs transition-colors cursor-pointer shadow-2xs';
      delBtn.title = 'Delete image';
      delBtn.innerHTML = '🗑️';
      delBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        URL.revokeObjectURL(item.previewUrl);
        selectedImagesList.splice(index, 1);
        renderImageStage();
      });
      actions.appendChild(delBtn);

      tile.appendChild(actions);
      imgTilesGrid.appendChild(tile);
    });
  }

  function handleIncomingImages(files: FileList | File[]) {
    const valid = Array.from(files).filter(f => f.type.startsWith('image/'));
    if (valid.length === 0) {
      alert('Please select valid image files (JPG, PNG, WebP, TIFF, BMP).');
      return;
    }

    const newItems: ImageItem[] = valid.map(f => ({
      file: f,
      rotation: 0,
      previewUrl: URL.createObjectURL(f)
    }));

    selectedImagesList = [...selectedImagesList, ...newItems];

    // Check size limit (100 MB for guest)
    const totalBytes = selectedImagesList.reduce((acc, it) => acc + it.file.size, 0);
    const totalMB = (totalBytes / (1024 * 1024)).toFixed(1);

    if (totalBytes > MAX_FREE_SIZE_BYTES) {
      if (!isUserLoggedIn()) {
        pendingLargeFile = selectedImagesList;
        largeFileSizeBadge.textContent = `${totalMB} MB`;
        largeFileAlert.classList.remove('hidden');
        createPdfBtn.disabled = true;

        if ((window as any).openAuthModal) {
          (window as any).openAuthModal(true, {
            title: `Batch is ${totalMB} MB (Free limit: 100 MB)`,
            text: `Your images total ${totalMB} MB. Sign up for free in 10 seconds to convert batches up to 1 GB!`
          });
        }
        return;
      }
    }

    largeFileAlert.classList.add('hidden');
    pendingLargeFile = null;
    renderImageStage();
  }

  imgInput?.addEventListener('change', e => {
    const files = (e.target as HTMLInputElement).files;
    if (files) handleIncomingImages(files);
  });
  imgAddMoreInput?.addEventListener('change', e => {
    const files = (e.target as HTMLInputElement).files;
    if (files) handleIncomingImages(files);
  });

  imgDz?.addEventListener('dragover', e => { e.preventDefault(); imgDz.classList.add('border-[#e60023]', 'bg-[#e5e5e0]'); });
  imgDz?.addEventListener('dragleave', () => { imgDz.classList.remove('border-[#e60023]', 'bg-[#e5e5e0]'); });
  imgDz?.addEventListener('drop', e => {
    e.preventDefault();
    imgDz.classList.remove('border-[#e60023]', 'bg-[#e5e5e0]');
    if (e.dataTransfer?.files) handleIncomingImages(e.dataTransfer.files);
  });

  // Sort A-Z by name
  sortImagesBtn?.addEventListener('click', () => {
    selectedImagesList.sort((a, b) => a.file.name.localeCompare(b.file.name));
    renderImageStage();
  });

  // Clear all
  clearImagesBtn?.addEventListener('click', () => {
    selectedImagesList.forEach(item => URL.revokeObjectURL(item.previewUrl));
    selectedImagesList = [];
    imgInput.value = '';
    imgAddMoreInput.value = '';
    renderImageStage();
  });

  // Convert Images to PDF Execution (iLovePDF Logic with Rotation & Options)
  createPdfBtn?.addEventListener('click', async () => {
    if (selectedImagesList.length === 0) return;

    createPdfBtn.style.display = 'none';
    progBox.classList.remove('hidden');
    doneBox.classList.add('hidden');

    try {
      const { jsPDF } = (window as any).jspdf;
      const shouldMerge = mergeAllCheck.checked;
      const total = selectedImagesList.length;

      // Helper function to render an image item onto canvas respecting rotation
      async function renderRotatedCanvas(item: ImageItem): Promise<HTMLCanvasElement> {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.onload = () => {
            const rot = item.rotation % 360;
            const canvas = document.createElement('canvas');
            if (rot === 90 || rot === 270) {
              canvas.width = img.naturalHeight || img.height;
              canvas.height = img.naturalWidth || img.width;
            } else {
              canvas.width = img.naturalWidth || img.width;
              canvas.height = img.naturalHeight || img.height;
            }
            const ctx = canvas.getContext('2d')!;
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.save();
            ctx.translate(canvas.width / 2, canvas.height / 2);
            ctx.rotate((rot * Math.PI) / 180);
            ctx.drawImage(img, -(img.naturalWidth || img.width) / 2, -(img.naturalHeight || img.height) / 2);
            ctx.restore();
            resolve(canvas);
          };
          img.onerror = () => reject(new Error('Failed to decode image ' + item.file.name));
          img.src = item.previewUrl;
        });
      }

      if (shouldMerge) {
        // Mode A: Merge all images into a single multi-page PDF
        let doc: any = null;

        for (let i = 0; i < total; i++) {
          const item = selectedImagesList[i];
          const pct = Math.round(((i + 1) / total) * 88);
          setProgress(pct, 'Converting images to PDF…', `Processing page ${i + 1} of ${total}: ${item.file.name}`);

          const canvas = await renderRotatedCanvas(item);
          const dataUrl = canvas.toDataURL('image/jpeg', 0.94);

          const imgW = canvas.width;
          const imgH = canvas.height;
          const imgAspect = imgW / imgH;

          // Orientation calculation
          let pageW = 210; // mm
          let pageH = 297;
          let pageOrient: 'p' | 'l' = currentImgOrientation === 'landscape' ? 'l' : 'p';

          if (currentImgPageSize === 'fit') {
            // Natural dimension fit (96 DPI)
            pageW = Math.max((imgW / 96) * 25.4, 40);
            pageH = Math.max((imgH / 96) * 25.4, 40);
            pageOrient = imgW > imgH ? 'l' : 'p';
          } else if (currentImgPageSize === 'letter') {
            pageW = 215.9;
            pageH = 279.4;
            if (pageOrient === 'l') { const t = pageW; pageW = pageH; pageH = t; }
          } else { // a4
            pageW = 210;
            pageH = 297;
            if (pageOrient === 'l') { const t = pageW; pageW = pageH; pageH = t; }
          }

          // Margin calculation (iLovePDF none / small / big)
          let marginMm = 0;
          if (currentImgMargin === 'small') marginMm = 10;
          if (currentImgMargin === 'big') marginMm = 20;

          const printableW = Math.max(pageW - (marginMm * 2), 10);
          const printableH = Math.max(pageH - (marginMm * 2), 10);

          let drawW = printableW;
          let drawH = printableH;
          let drawX = marginMm;
          let drawY = marginMm;

          if (currentImgPageSize !== 'fit') {
            if (imgAspect > (printableW / printableH)) {
              drawW = printableW;
              drawH = printableW / imgAspect;
              drawX = marginMm;
              drawY = marginMm + ((printableH - drawH) / 2);
            } else {
              drawH = printableH;
              drawW = printableH * imgAspect;
              drawX = marginMm + ((printableW - drawW) / 2);
              drawY = marginMm;
            }
          }

          if (i === 0) {
            doc = new jsPDF({
              orientation: pageOrient,
              unit: 'mm',
              format: currentImgPageSize === 'fit' ? [pageW, pageH] : (currentImgPageSize === 'letter' ? 'letter' : 'a4')
            });
            doc.addImage(dataUrl, 'JPEG', drawX, drawY, drawW, drawH, undefined, 'FAST');
          } else {
            doc.addPage(
              currentImgPageSize === 'fit' ? [pageW, pageH] : (currentImgPageSize === 'letter' ? 'letter' : 'a4'),
              pageOrient
            );
            doc.addImage(dataUrl, 'JPEG', drawX, drawY, drawW, drawH, undefined, 'FAST');
          }
        }

        setProgress(96, 'Finalizing PDF…', 'Building single merged document');
        const pdfBlob = doc.output('blob');
        downloadedResultBlob = pdfBlob;
        const firstBase = selectedImagesList[0]?.file.name.replace(/\.[^/.]+$/, '') || 'images';
        downloadedFileName = `${firstBase}_merged.pdf`;

        setProgress(100, 'Complete!', 'Document generated successfully');
        await new Promise(r => setTimeout(r, 200));

        progBox.classList.add('hidden');
        doneBox.classList.remove('hidden');
        doneBox.classList.add('flex');
        doneTitle.textContent = 'The images have been converted to PDF!';
        doneLbl.textContent = `${total} image${total > 1 ? 's' : ''} merged into 1 PDF · ${(pdfBlob.size / 1024).toFixed(0)} KB`;
        dlBtnText.textContent = 'Download PDF';

      } else {
        // Mode B: Generate individual PDFs in a ZIP
        const zip = new JSZip();

        for (let i = 0; i < total; i++) {
          const item = selectedImagesList[i];
          const pct = Math.round(((i + 1) / total) * 88);
          setProgress(pct, 'Converting individual PDFs…', `Converting ${i + 1} of ${total}: ${item.file.name}`);

          const canvas = await renderRotatedCanvas(item);
          const dataUrl = canvas.toDataURL('image/jpeg', 0.94);

          const imgW = canvas.width;
          const imgH = canvas.height;
          let pageW = Math.max((imgW / 96) * 25.4, 40);
          let pageH = Math.max((imgH / 96) * 25.4, 40);
          let pageOrient: 'p' | 'l' = imgW > imgH ? 'l' : 'p';

          const singleDoc = new jsPDF({
            orientation: pageOrient,
            unit: 'mm',
            format: [pageW, pageH]
          });
          singleDoc.addImage(dataUrl, 'JPEG', 0, 0, pageW, pageH, undefined, 'FAST');
          const singleBlob = singleDoc.output('blob');
          const baseName = item.file.name.replace(/\.[^/.]+$/, '');
          zip.file(`${baseName}.pdf`, singleBlob);
        }

        setProgress(95, 'Packaging ZIP…', 'Archiving individual PDF files');
        const zipBlob = await zip.generateAsync({ type: 'blob', compression: 'DEFLATE' });
        downloadedResultBlob = zipBlob;
        downloadedFileName = 'converted_pdfs.zip';

        setProgress(100, 'Complete!', 'Individual PDFs archived');
        await new Promise(r => setTimeout(r, 200));

        progBox.classList.add('hidden');
        doneBox.classList.remove('hidden');
        doneBox.classList.add('flex');
        doneTitle.textContent = 'Individual PDFs ready!';
        doneLbl.textContent = `${total} PDF files packaged in ZIP · ${(zipBlob.size / 1024).toFixed(0)} KB`;
        dlBtnText.textContent = 'Download ZIP';
      }

    } catch (err) {
      console.error(err);
      progBox.classList.add('hidden');
      createPdfBtn.style.display = 'flex';
      alert('PDF conversion failed: ' + (err as Error).message);
    }
  });

  /* ══════════════════════════════════════════════════════════
     Shared Download & Reset Handlers
  ══════════════════════════════════════════════════════════ */
  dlBtn?.addEventListener('click', () => {
    if (!downloadedResultBlob) return;
    const url = URL.createObjectURL(downloadedResultBlob);
    const a = document.createElement('a');
    a.href = url;
    a.download = downloadedFileName;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  });

  rstBtn?.addEventListener('click', () => {
    downloadedResultBlob = null;
    hideAllResults();

    if (currentMode === 'pdf-to-img') {
      selectedPdfFile = null;
      cvtBtn.disabled = true;
      cvtBtn.style.display = 'flex';
      fi.value = '';
      dzL.innerHTML = 'Drop your PDF here, or <span class="text-[#e60023] underline underline-offset-2">browse files</span>';
      if (cvtBtnText) cvtBtnText.textContent = `Convert PDF to ${currentFormat.toUpperCase()}`;
    } else {
      selectedImagesList.forEach(item => URL.revokeObjectURL(item.previewUrl));
      selectedImagesList = [];
      imgInput.value = '';
      imgAddMoreInput.value = '';
      createPdfBtn.style.display = 'flex';
      createPdfBtn.disabled = true;
      renderImageStage();
    }
  });

  /* ── Large File Card Actions ── */
  document.getElementById('largeFileSignupBtn')?.addEventListener('click', () => {
    if ((window as any).openAuthModal) {
      (window as any).openAuthModal(true, {
        title: 'Batch / File Over 100 MB Limit',
        text: 'Create a free account in seconds to unlock conversions up to 1 GB!'
      });
    }
  });

  document.getElementById('largeFileLoginBtn')?.addEventListener('click', () => {
    if ((window as any).openAuthModal) {
      (window as any).openAuthModal(false, {
        title: 'Batch / File Over 100 MB Limit',
        text: 'Sign in to your account to unlock conversions up to 1 GB!'
      });
    }
  });

  function updateLimitUI() {
    const dzLimitText = document.getElementById('dzLimitText');
    const imgDzLimitText = document.getElementById('imgDzLimitText');
    if (isUserLoggedIn()) {
      if (dzLimitText) dzLimitText.innerHTML = '<span class="text-[#103c25] font-bold">✓ Signed in:</span> Up to 1 GB supported · PDF only';
      if (imgDzLimitText) imgDzLimitText.innerHTML = '<span class="text-[#103c25] font-bold">✓ Signed in:</span> Up to 1 GB supported · Multiple images';
      if (pendingLargeFile) {
        largeFileAlert.classList.add('hidden');
        if (Array.isArray(pendingLargeFile)) {
          selectedImagesList = pendingLargeFile;
          pendingLargeFile = null;
          renderImageStage();
        } else {
          const fileToLoad = pendingLargeFile;
          pendingLargeFile = null;
          setPdfFile(fileToLoad);
        }
      }
    } else {
      if (dzLimitText) dzLimitText.textContent = 'Up to 100 MB for guests · Sign up for up to 1 GB';
      if (imgDzLimitText) imgDzLimitText.textContent = 'Supports JPG, PNG, WebP, TIFF, BMP · Up to 100 MB for guests';
    }
  }

  window.addEventListener('authChange', updateLimitUI);
  updateLimitUI();
</script>
