---
// Pinterest 3-Step Process & Creator CTA per DESIGN.md
---

<section id="howitworks" class="py-16 md:py-24 px-4 md:px-6 bg-[#fbfbf9] border-b border-[#dadad3]">
  <div class="max-w-[1280px] mx-auto">

    <!-- Header -->
    <div class="text-center max-w-[620px] mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#f6f6f3] text-xs font-bold text-[#62625b] mb-3 border border-[#dadad3]">
        ⚙️ Simple Workflow
      </div>
      <h2 class="text-[28px] sm:text-[38px] font-bold text-[#000000] tracking-[-1.2px] leading-tight mb-3">
        Three steps to perfect image pins
      </h2>
      <p class="text-base text-[#62625b]">
        No complicated settings. Drop your file, pick your favorite format, and download.
      </p>
    </div>

    <!-- 3 Steps Grid: 16px radius, warm cream cards per DESIGN.md -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {[
        {
          num: "01",
          icon: "☁️",
          title: "Select your PDF",
          desc: "Drag and drop your document onto the dropzone or click to browse. Files up to 100 MB for guests, or 1 GB with a free account.",
        },
        {
          num: "02",
          icon: "🎨",
          title: "Pick format & resolution",
          desc: "Choose from JPG, PNG, WebP, TIFF, or BMP. Fine-tune your quality slider and select 150, 200, or 300 DPI.",
        },
        {
          num: "03",
          icon: "⬇️",
          title: "Save instant ZIP pins",
          desc: "Watch our real-time renderer process each page. Download the complete set as a single organized ZIP archive.",
        },
      ].map((step) => (
        <div class="bg-[#ffffff] border border-[#dadad3] rounded-[16px] p-8 relative flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="w-12 h-12 rounded-full bg-[#f6f6f3] border border-[#dadad3] flex items-center justify-center text-2xl shadow-xs">
                {step.icon}
              </span>
              <span class="text-3xl font-black text-[#e5e5e0] tracking-tighter">
                {step.num}
              </span>
            </div>
            <h3 class="text-[20px] font-bold text-[#000000] tracking-[-0.5px] mb-2 leading-snug">
              {step.title}
            </h3>
            <p class="text-sm text-[#62625b] leading-relaxed">
              {step.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#e5e5e0] text-xs font-bold text-[#000000]">
            Step {step.num}
          </div>
        </div>
      ))}
    </div>

    <!-- Magazine-style CTA Banner: Charcoal (#262622) with Pinterest Red CTA -->
    <div class="bg-[#262622] rounded-[16px] p-8 md:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <span class="text-xs font-bold tracking-wider uppercase text-[#c7f0da] bg-[#103c25] px-3 py-1 rounded-full mb-3 inline-block">
          Instant & Free
        </span>
        <h3 class="text-2xl md:text-3xl font-bold tracking-[-1px] text-white mb-2">
          Ready to convert your PDF?
        </h3>
        <p class="text-sm text-white/70 max-w-[500px]">
          No email required for standard files. Start converting right away or sign up for 1 GB uploads.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="#converter"
          class="h-12 px-6 rounded-2xl bg-[#e60023] hover:bg-[#cc001f] text-white text-sm font-bold flex items-center gap-2 transition-colors shadow-md"
        >
          <span>Convert a PDF now</span>
          <span>→</span>
        </a>
      </div>
    </div>

  </div>
</section>
