---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sign up — PDFSpark">
  <div class="min-h-screen bg-[#fbfbf9] flex flex-col justify-center items-center p-4 sm:p-6">

    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 mb-8 group">
      <div class="w-10 h-10 rounded-full bg-[#e60023] flex items-center justify-center text-white text-xl font-black shadow-sm group-hover:bg-[#cc001f] transition-colors">
        ⚡
      </div>
      <span class="font-bold text-2xl tracking-tight text-[#e60023]">PDFSpark</span>
    </a>

    <!-- Modal Card per DESIGN.md: 32px radius, canvas white, 16px ambient shadow -->
    <div class="w-full max-w-[440px] bg-[#ffffff] rounded-[32px] shadow-[0_16px_36px_rgba(0,0,0,0.08)] border border-[#dadad3] p-8 sm:p-10">
      <h1 class="text-2xl font-bold text-[#000000] tracking-[-0.8px] text-center mb-1">Create your free account</h1>
      <p class="text-xs text-[#62625b] text-center mb-6">Unlock files up to 1 GB, batch tools, and high-DPI export</p>

      <!-- OAuth button -->
      <div class="space-y-2 mb-6">
        <button id="pageGoogleSignupBtn" type="button" class="w-full h-11 flex items-center justify-center gap-2.5 px-4 bg-[#e5e5e0] hover:bg-[#c8c8c1] rounded-[16px] text-xs font-bold text-[#000000] transition-colors cursor-pointer">
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
          </svg>
          Sign up with Google
        </button>
      </div>

      <div class="relative flex items-center justify-center mb-6">
        <div class="border-t border-[#dadad3] w-full"></div>
        <span class="bg-[#ffffff] px-3 text-[11px] font-bold text-[#91918c] uppercase tracking-wider absolute">OR</span>
      </div>

      <form id="pageSignupForm" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-[#000000] mb-1" for="signupName">Full Name</label>
          <input
            type="text"
            id="signupName"
            required
            placeholder="Your name"
            class="w-full h-11 px-4 rounded-[16px] border border-[#dadad3] text-sm text-[#000000] placeholder:text-[#91918c] bg-[#ffffff] focus:border-[#000000] focus:ring-2 focus:ring-[#435ee5] transition-all outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-[#000000] mb-1" for="signupEmail">Email</label>
          <input
            type="email"
            id="signupEmail"
            required
            placeholder="name@example.com"
            class="w-full h-11 px-4 rounded-[16px] border border-[#dadad3] text-sm text-[#000000] placeholder:text-[#91918c] bg-[#ffffff] focus:border-[#000000] focus:ring-2 focus:ring-[#435ee5] transition-all outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-[#000000] mb-1" for="signupPassword">Password</label>
          <input
            type="password"
            id="signupPassword"
            required
            placeholder="At least 8 characters"
            class="w-full h-11 px-4 rounded-[16px] border border-[#dadad3] text-sm text-[#000000] placeholder:text-[#91918c] bg-[#ffffff] focus:border-[#000000] focus:ring-2 focus:ring-[#435ee5] transition-all outline-none"
          />
        </div>

        <div id="signupAlert" class="hidden p-3 rounded-[16px] text-xs font-bold bg-[#c7f0da] text-[#103c25]"></div>

        <button
          type="submit"
          class="w-full h-11 rounded-[16px] bg-[#e60023] hover:bg-[#cc001f] text-white text-sm font-bold flex items-center justify-center transition-colors cursor-pointer shadow-sm"
        >
          Create account
        </button>
      </form>

      <p class="text-xs text-center text-[#62625b] mt-6">
        Already on PDFSpark? 
        <a href="/login" class="text-[#e60023] font-bold hover:underline">Log in</a>
      </p>
    </div>

    <!-- Back to home -->
    <a href="/" class="mt-8 text-xs font-semibold text-[#62625b] hover:text-[#000000] transition-colors flex items-center gap-1.5">
      ← Back to converter
    </a>
  </div>
</Layout>

<script>
  const form = document.getElementById('pageSignupForm') as HTMLFormElement;
  const nameInput = document.getElementById('signupName') as HTMLInputElement;
  const emailInput = document.getElementById('signupEmail') as HTMLInputElement;
  const alertBox = document.getElementById('signupAlert')!;
  const googleBtn = document.getElementById('pageGoogleSignupBtn');

  function registerUser(name: string, email: string) {
    const user = {
      name: name,
      email: email,
      avatar: name.charAt(0).toUpperCase()
    };
    localStorage.setItem('pdfspark_user', JSON.stringify(user));
    alertBox.textContent = 'Account created successfully! Redirecting...';
    alertBox.classList.remove('hidden');

    setTimeout(() => {
      window.location.href = '/';
    }, 600);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    if (name && email) registerUser(name, email);
  });

  googleBtn?.addEventListener('click', () => {
    registerUser('Google User', 'user@google.com');
  });
</script>
